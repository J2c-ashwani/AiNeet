# ============================================
# NEET Coach - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Core app
NODE_ENV=development
CI=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_VERSION=local
NEXT_PUBLIC_VERCEL_ENV=development
BASE_URL=http://localhost:3000
JWT_SECRET=
DIAGNOSTIC_SIGNING_SECRET=
INTERNAL_EVENT_SECRET=

# Supabase - required for backend routes
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CI aliases used by maintenance workflows/scripts.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
STAGING_DATABASE_URL=
BACKUP_RESTORE_DRILL_ID=

# Redis / rate limits / lightweight queues
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature kill switches
SAFE_MODE=false
DISABLE_AI=false
DISABLE_PAYMENTS=false
DISABLE_REFERRALS=false

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
EXPECTED_EMBEDDING_DIMENSIONS=3072

# Cashfree payments
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
PAYMENT_FLOW_BASE_URL=

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Local development only. Must remain unset/false in production.
GOOGLE_PLAY_ALLOW_MOCK=false

# Cron and automation security
CRON_SECRET=
N8N_WEBHOOK_SECRET=

# Firebase / mobile notifications
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICES_JSON=
# off in local dev, native in production, strict after web App Check is configured.
APP_CHECK_ENFORCEMENT=off
APP_CHECK_TEST_BASE_URL=
APP_CHECK_TEST_AUTH_COOKIE=
APP_CHECK_TEST_BEARER=

# Mobile OMR uploads
OMR_SCAN_BUCKET=omr-scans
OMR_SCAN_MAX_BYTES=15728640

# Android release packaging (local/CI only; do not expose to web runtime)
NEET_WEB_URL=https://aineetcoach.com/login
NEET_UPLOAD_KEYSTORE=
NEET_UPLOAD_KEYSTORE_BASE64=
NEET_UPLOAD_KEYSTORE_PASSWORD=
NEET_UPLOAD_KEY_ALIAS=
NEET_UPLOAD_KEY_PASSWORD=
ADMOB_ANDROID_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_REWARDED_ANDROID=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=NEET Coach <noreply@example.com>

# Alerts and observability
NEXT_PUBLIC_SENTRY_DSN=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
FIREBASE_TOKEN=

# Certification/load testing
CHAOS_BASE_URL=
LOAD_TEST_BASE_URL=
LOAD_TEST_CONCURRENCY=50
LOAD_TEST_AI_CONCURRENCY=5
LOAD_TEST_ALLOW_PRODUCTION=false
LOAD_TEST_JWT=
RAG_ALLOW_MOCK=false

# E2E / QA Testing credentials (never commit real values)
QA_USER_EMAIL=
QA_USER_PASSWORD=
