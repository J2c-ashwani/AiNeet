# ============================================
# NEET Coach - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Core app
NODE_ENV=development
CI=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_VERSION=local
NEXT_PUBLIC_VERCEL_ENV=development
BASE_URL=http://localhost:3000
JWT_SECRET=
DIAGNOSTIC_SIGNING_SECRET=
INTERNAL_EVENT_SECRET=

# Supabase - required for backend routes
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Redis / rate limits / lightweight queues
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Feature kill switches
SAFE_MODE=false
DISABLE_AI=false
DISABLE_PAYMENTS=false
DISABLE_REFERRALS=false

# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cashfree payments
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Local development only. Must remain unset/false in production.
GOOGLE_PLAY_ALLOW_MOCK=false

# Cron and automation security
CRON_SECRET=
N8N_WEBHOOK_SECRET=

# Firebase / mobile notifications
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Mobile OMR uploads
OMR_SCAN_BUCKET=omr-scans
OMR_SCAN_MAX_BYTES=15728640

# Android release packaging (local/CI only; do not expose to web runtime)
NEET_UPLOAD_KEYSTORE=
NEET_UPLOAD_KEYSTORE_PASSWORD=
NEET_UPLOAD_KEY_ALIAS=
NEET_UPLOAD_KEY_PASSWORD=
ADMOB_ANDROID_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_INTERSTITIAL_ANDROID=
ADMOB_REWARDED_ANDROID

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=NEET Coach <noreply@example.com>

# Alerts and observability
NEXT_PUBLIC_SENTRY_DSN=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
